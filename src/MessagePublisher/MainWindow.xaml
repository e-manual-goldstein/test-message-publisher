<Window x:Class="MessagePublisher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MessagePublisher"
        xmlns:vm="clr-namespace:MessagePublisher.ViewModels"
        xmlns:conv="clr-namespace:MessagePublisher.Converters"
        mc:Ignorable="d"
        Title="Message Publisher"
        Height="640"
        Width="960">
  <Window.DataContext>
    <local:MainViewModel />
  </Window.DataContext>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:InverseBooleanConverter x:Key="InvBool" />
    <conv:EditorKindToVisibilityConverter x:Key="VisString" MatchKind="String" />
    <conv:EditorKindToVisibilityConverter x:Key="VisByteArray" MatchKind="ByteArray" />
    <conv:EditorKindToVisibilityConverter x:Key="VisBool" MatchKind="Boolean" />
    <conv:EditorKindToVisibilityConverter x:Key="VisEnum" MatchKind="Enum" />
  </Window.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <GroupBox Header="Package" Grid.Row="0" Margin="0,0,0,8" Padding="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Feed URL (v3)" Margin="0,0,8,4" />
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding FeedUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />

        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Package id" Margin="0,0,8,4" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PackageId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,4" />
        <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Version" Margin="0,0,8,4" />
        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding PackageVersion, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />

        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Base type (full name)" Margin="0,0,8,0" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BaseTypeFullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
        <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Text="User / Password" Margin="0,0,8,0" />
        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal">
          <TextBox Width="120" Margin="0,0,8,0" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" ToolTip="Optional Nexus user" />
          <PasswordBox x:Name="PasswordBox" Width="160" PasswordChanged="PasswordBox_OnPasswordChanged" ToolTip="Optional Nexus password / token" />
        </StackPanel>
      </Grid>
    </GroupBox>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <Button DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="8,4" Content="Load package"
                Command="{Binding LoadPackageCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" />
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="Message types" FontWeight="SemiBold" Margin="0,0,0,4" />
          <ListBox ItemsSource="{Binding MessageTypes}" SelectedIndex="{Binding SelectedMessageTypeIndex, Mode=TwoWay}" MinHeight="200" />
          <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="Gray" FontSize="11" />
        </StackPanel>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#EEE" />

      <DockPanel Grid.Column="2">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
          <Button Padding="10,4" Content="Build serialized payload" Command="{Binding BuildSerializedCommand}" />
          <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray" FontSize="11"
                     Text="MSMQ send is not wired yet; this preview is the payload string step." />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding PropertyEditors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:PropertyEditorViewModel}">
                <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,0,0,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="160" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                    <StackPanel Grid.Column="1">
                      <TextBlock FontSize="11" Foreground="Gray" Margin="0,0,0,4" Text="{Binding PropertyType.Name, StringFormat=Type: {0}}" />
                      <CheckBox Visibility="{Binding EditorKind, Converter={StaticResource VisBool}}"
                                IsChecked="{Binding BoolValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Content="True / False"
                                VerticalAlignment="Center" />
                      <TextBox Visibility="{Binding EditorKind, Converter={StaticResource VisString}}"
                               Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               MinHeight="28" />
                      <TextBox Visibility="{Binding EditorKind, Converter={StaticResource VisByteArray}}"
                               Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               FontFamily="Consolas"
                               MinHeight="56"
                               ToolTip="Base64 or hex (optional 0x, spaces ignored)" />
                      <TextBox Visibility="{Binding EditorKind, Converter={StaticResource VisEnum}}"
                               Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="Enum name or numeric value" />
                      <TextBox>
                        <TextBox.Style>
                          <Style TargetType="TextBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding EditorKind}" Value="{x:Static vm:PropertyEditorKind.Integer}">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding EditorKind}" Value="{x:Static vm:PropertyEditorKind.Decimal}">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding EditorKind}" Value="{x:Static vm:PropertyEditorKind.Floating}">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding EditorKind}" Value="{x:Static vm:PropertyEditorKind.Guid}">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding EditorKind}" Value="{x:Static vm:PropertyEditorKind.DateTime}">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding EditorKind}" Value="{x:Static vm:PropertyEditorKind.DateTimeOffset}">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBox.Style>
                        <TextBox.Text>
                          <Binding Path="ValueText" UpdateSourceTrigger="PropertyChanged" />
                        </TextBox.Text>
                      </TextBox>
                      <TextBlock Foreground="DarkRed" FontSize="11" Margin="0,4,0,0"
                                 Text="{Binding ErrorMessage}"
                                 Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Grid>

    <GroupBox Header="Serialized payload" Grid.Row="2" Margin="0,8,0,0" Padding="8">
      <TextBox Text="{Binding SerializedPreview, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
               TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="100" FontFamily="Consolas" FontSize="12" />
    </GroupBox>
  </Grid>
</Window>
